FROM node:20-alpine

# Install Postgres, Supervisor
RUN apk add --no-cache postgresql postgresql-contrib postgresql-client supervisor openssl

# Set up Postgres
RUN mkdir -p /run/postgresql && chown -R postgres:postgres /run/postgresql
RUN mkdir -p /var/lib/postgresql/data && chown -R postgres:postgres /var/lib/postgresql/data
ENV PGDATA=/var/lib/postgresql/data

WORKDIR /app

# Copy API
COPY app/api /app/api
WORKDIR /app/api
RUN npm install
RUN npx prisma generate
RUN npm run build

# Copy Web
WORKDIR /app
COPY app/web /app/web
WORKDIR /app/web
RUN npm install --legacy-peer-deps
ENV NEXT_PUBLIC_API_URL=http://localhost:3001/api
RUN npm run build

# Copy Scripts and Configs
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/start-postgres.sh /usr/local/bin/start-postgres.sh
RUN chmod +x /usr/local/bin/start-postgres.sh

# Main start command
WORKDIR /app
EXPOSE 3000 3001 5432

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
