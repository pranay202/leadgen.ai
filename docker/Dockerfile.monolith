FROM node:20-alpine

# Install all runtime services in one image. Nginx exposes one public port and
# proxies /api to the API, so the app can be started with a single docker run.
RUN apk add --no-cache nginx postgresql postgresql-contrib postgresql-client supervisor openssl

# Set up Postgres
RUN mkdir -p /run/postgresql && chown -R postgres:postgres /run/postgresql
RUN mkdir -p /var/lib/postgresql/data && chown -R postgres:postgres /var/lib/postgresql/data
ENV PGDATA=/var/lib/postgresql/data

WORKDIR /app

# Copy API
COPY app/api /app/api
WORKDIR /app/api
RUN npm ci
RUN npx prisma generate
RUN npm run build

# Copy Web
WORKDIR /app
COPY app/web /app/web
WORKDIR /app/web
RUN npm ci --legacy-peer-deps
ENV NEXT_PUBLIC_API_URL=/api
RUN npm run build

# Copy Scripts and Configs
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/start-postgres.sh /usr/local/bin/start-postgres.sh
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY docker/nginx.conf /etc/nginx/http.d/default.conf
RUN chmod +x /usr/local/bin/start-postgres.sh /usr/local/bin/entrypoint.sh

# Main start command
WORKDIR /app
VOLUME ["/var/lib/postgresql/data"]
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
